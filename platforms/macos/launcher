#!/bin/bash
set -euo pipefail
resources="$(cd "$(dirname "$0")/../Resources" && pwd)"
umask 077
logdir="$HOME/Library/Logs/Hermes"
mkdir -p "$logdir"
if ! /bin/bash "$resources/bootstrap.command" >"$logdir/setup.log" 2>&1; then
    /usr/bin/osascript -e 'display alert "Hermes setup stopped" message "See ~/Library/Logs/Hermes/setup.log for details. Open Hermes Setup to retry."'
    exit 1
fi
