[Unit]
Description=Hermes managed Chromium browser
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
UMask=0077
Environment=HERMES_ROOT=%h/hermes-v4
EnvironmentFile=-%h/.config/hermes/appliance.env
EnvironmentFile=-%h/.config/hermes/appliance.env
ExecStart=%h/hermes-v4/.venv/bin/python %h/hermes-v4/managed_browser_launcher.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=default.target
