[Unit]
Description=Hermes Alpha service health and recovery check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/hermes-v4
Environment=HERMES_ROOT=%h/hermes-v4
ExecStart=%h/hermes-v4/.venv/bin/python %h/hermes-v4/hermes_health_monitor.py
TimeoutStartSec=180
